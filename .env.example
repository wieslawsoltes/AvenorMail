# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
# Initial owner account, created only when the database has no accounts. Minimum 12 characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Workspace owner
PUBLIC_URL=http://localhost:3000
# Set this to https://wieslawsoltes.github.io/AvenorMail/ when connecting Pages.
FRONTEND_URL=http://localhost:3000/
DATA_DIR=./data
SEED_SAMPLE_DATA=false
# OAuth callback: PUBLIC_URL/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# OAuth callback: PUBLIC_URL/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional enterprise sign-in. Callback: PUBLIC_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
