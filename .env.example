# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
# Initial owner account, created only when the database has no accounts. Minimum 12 characters.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Workspace owner
PUBLIC_URL=http://localhost:3000
# Set this to https://wieslawsoltes.github.io/AvenorMail/ when connecting Pages.
FRONTEND_URL=http://localhost:3000/
DATA_DIR=./data
SEED_SAMPLE_DATA=false
# OAuth callback: PUBLIC_URL/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# OAuth callback: PUBLIC_URL/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional enterprise sign-in. Callback: PUBLIC_URL/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=

# Optional shared database. Use a remote libSQL writer endpoint for multiple hosts.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Same-host process count. Each worker receives a unique node ID.
WEB_CONCURRENCY=1
CLUSTER_NODE_ID=
CLUSTER_POLL_MS=500
# Shared encrypted attachment storage. SDK reads AWS credentials from the server environment/role.
S3_BUCKET=
S3_PREFIX=avenor/
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_REGION=us-east-1
# Optional Microsoft directory candidate search scope; requires reauthorization/admin consent as applicable.
MICROSOFT_DIRECTORY_DISCOVERY=false
# Optional signed, idempotent external audit archive endpoint; see docs/COMPLIANCE.md.
AUDIT_SINK_URL=
AUDIT_SINK_TOKEN=
AUDIT_SINK_HMAC_KEY=
COMPLIANCE_EXPORT_MAX_BYTES=52428800
